{
  "name": "admin-scaffold-frontend",
  "private": true,
  "version": "0.1.0",
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-renderer-artifacts.mjs web",
    "build:web": "tsc -b && vite build && node scripts/verify-renderer-artifacts.mjs web",
    "build:demo": "tsc -b && vite build --mode demo",
    "dev:desktop": "node scripts/desktop-command.mjs dev",
    "build:desktop": "node scripts/desktop-command.mjs build",
    "make:desktop": "node scripts/desktop-command.mjs make",
    "guard:desktop": "node scripts/desktop-boundary-guard.mjs",
    "verify:desktop": "node scripts/verify-renderer-artifacts.mjs desktop",
    "verify:release": "node scripts/verify-release-artifacts.mjs",
    "verify:update-feed": "node scripts/verify-update-feed.mjs",
    "test:desktop:unit": "pnpm guard:desktop && vitest run --config vitest.desktop.config.ts",
    "test:desktop": "pnpm test:desktop:unit && node scripts/run-packaged-spike.mjs",
    "typecheck": "tsc -b --noEmit",
    "typecheck:desktop": "tsc -p tsconfig.desktop.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "theme:guard": "vitest run src/styles/__tests__/theme-guards.test.ts src/styles/__tests__/tokens.snapshot.test.ts src/styles/__tests__/profile-contract.test.ts src/app/__tests__/module-boundaries.test.ts",
    "design:lint": "node scripts/design-md-lint.mjs",
    "visual": "node scripts/visual-agent-browser.mjs all",
    "visual:baseline": "node scripts/visual-agent-browser.mjs baseline",
    "visual:app": "node scripts/visual-agent-browser.mjs app",
    "visual:scale": "node scripts/visual-agent-browser.mjs scale",
    "visual:matrix": "node scripts/visual-agent-browser.mjs matrix",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "6.8.9",
    "i18next": "^26.3.4",
    "lucide-react": "^1.23.0",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-i18next": "^17.0.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "1.61.1",
    "@tanstack/router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.1.0",
    "electron-builder": "26.15.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "js-yaml": "4.3.0",
    "msw": "^2.14.6",
    "prettier": "^3.9.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.1",
    "vite": "8.1.1",
    "vite-plugin-electron": "1.1.0",
    "vitest": "^4.1.9"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
